# Reservas: "supabase" (producción), "demo" (sin base de datos, solo pruebas) o "calcom" (futuro).
BOOKING_PROVIDER=supabase

# Supabase → Project Settings → API. La service role solo se usa en el servidor.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend → API Keys. El remitente debe ser de un dominio verificado (p. ej. citas@goodview.es).
RESEND_API_KEY=
EMAIL_FROM="goodview <citas@goodview.es>"
EMAIL_NOTIFY_TO=hola@goodview.es

# Texto aleatorio para anonimizar las IP del límite de peticiones.
RATE_LIMIT_SALT=
ADMIN_SESSION_SECRET=
